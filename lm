#!/bin/sh
# lm — одна команда на все локальные модели этой машины.
#
#   lm                     интерактивное меню (fzf) — то же, что открывает клавиша
#   lm status              состояние серверов, порты, VRAM, размер ответа модели
#   lm start [all|fast|think]   поднять серверы (fast = MiniCPM5-2B :8091, think = VibeThinker-3B :8092)
#   lm stop                остановить
#   lm restart             перезапустить
#   lm ask "вопрос"        спросить воркера (MiniCPM); --clip — взять текст из буфера
#   lm think "задача"      замкнутая задача ризонеру (VibeThinker); --clip — из буфера
#   lm tabs [--domain]     разобрать вкладки Zen (проект zen-tabs)
#   lm plan                посчитать план пространств Zen (модель 4B на CPU) и раздать его
#   lm plan-model          поднять только модель планирования (4B, CPU, порт 8094)
#   lm plan-serve          только раздать готовый план на 127.0.0.1:8093
#   lm plan-stop           остановить раздачу
#   lm eval                замер SemIf на 144 авторских пунктах
#   lm logs [fast|think]   последние строки лога
#   lm up                  тихая проверка: 0 — оба сервера живы (для скриптов и меню)
#   lm notify-status       уведомление рабочего стола с состоянием
#
# Всё остальное живёт в ~/Projects/localmix (start.sh, stop.sh, think.sh).
set -u

# Скрипт лежит в проекте, а в PATH попадает симлинком — путь надо разрешить,
# иначе DIR укажет на ~/.local/bin и start.sh «не найдётся».
SELF="$0"
while [ -L "$SELF" ]; do
    target="$(readlink "$SELF")"
    case "$target" in
        /*) SELF="$target" ;;
        *) SELF="$(dirname "$SELF")/$target" ;;
    esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
RUN_DIR="$DIR/run"
LOG_DIR="$DIR/logs"
mkdir -p "$RUN_DIR" "$LOG_DIR"
FAST_PORT="${FAST_PORT:-8091}"
THINK_PORT="${THINK_PORT:-8092}"
ZT="$HOME/Projects/zen-tabs"
RUNTIME=0.2

# Шим mise без выставленной версии падает («No version is set for shim: bun»),
# поэтому ищем рабочий бинарь и проверяем его делом, а не наличием.
find_bun() {
    for candidate in "$HOME"/.local/share/mise/installs/bun/*/bin/bun "$(command -v bun 2>/dev/null)"; do
        [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" --version >/dev/null 2>&1 && {
            printf '%s' "$candidate"
            return 0
        }
    done
    return 1
}
BUN="$(find_bun || echo bun)"

say() { printf '%s\n' "$*"; }
err() { printf '%s\n' "$*" >&2; }

alive() { # alive <порт>
    curl -sf -m 2 -o /dev/null "http://127.0.0.1:$1/v1/models" 2>/dev/null
}

model_name() { # model_name <порт> — короткое имя модели из /v1/models
    curl -sf -m 2 "http://127.0.0.1:$1/v1/models" 2>/dev/null |
        sed -n 's/.*"model":"[^"]*\/\([^"]*\)\.gguf".*/\1/p' | head -1
}

free_vram() {
    nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader,nounits 2>/dev/null |
        awk -F', ' '{printf "%.1f GB занято, %.1f GB свободно", $1/1024, ($2-$1)/1024}'
}

status_line() { # status_line <fast|think> <порт> <подпись>
    if alive "$2"; then
        printf '  ● %-6s :%s  %s\n' "$1" "$2" "$(model_name "$2" || echo "$3")"
    else
        printf '  ○ %-6s :%s  выключен (%s)\n' "$1" "$2" "$3"
    fi
}

cmd_status() {
    say "Локальные модели:"
    status_line fast "$FAST_PORT" "MiniCPM5-2B Q4, воркер"
    status_line think "$THINK_PORT" "VibeThinker-3B Q4, ризонер"
    say "  видео: $(free_vram)"
    if [ -d "$ZT" ]; then
        say "  разбор вкладок Zen: lm tabs (по доменам: lm tabs --domain)"
    fi
    if alive "$FAST_PORT" && alive "$THINK_PORT"; then
        return 0
    else
        return 1
    fi
}

cmd_notify_status() {
    if cmd_status >/tmp/lm-status.$$ 2>&1; then
        notify-send -i dialog-information "Локальные модели: работают" "$(cat /tmp/lm-status.$$)"
    else
        notify-send -i dialog-warning "Локальные модели: остановлены" "$(cat /tmp/lm-status.$$)"
    fi
    rm -f /tmp/lm-status.$$
}

cmd_start() {
    case "${1:-all}" in
        all | "") "$DIR/start.sh" ;;
        fast | think) "$DIR/start.sh" "$1" ;;
        *) err "lm start [all|fast|think]"; return 2 ;;
    esac
}

cmd_stop() { "$DIR/stop.sh"; }

cmd_ask() { # воркер: MiniCPM5-2B, рецепт из start.sh (min_p=0 обязателен)
    if [ "${1:-}" = "--clip" ]; then
        PROMPT="$(wl-paste --no-newline 2>/dev/null || true)"
        [ -n "$PROMPT" ] || { err "буфер обмена пуст"; return 1; }
    elif [ -n "${1:-}" ]; then
        PROMPT="$1"
    else
        PROMPT="$(cat)"
    fi
    [ -n "$PROMPT" ] || { err "Пустой запрос."; return 2; }

    BODY="$(PROMPT="$PROMPT" python3 -c '
import json, os
print(json.dumps({
    "model": "local",
    "messages": [
        {"role": "system", "content": "Отвечай кратко и по делу, по-русски."},
        {"role": "user", "content": os.environ["PROMPT"]},
    ],
    "max_tokens": 700, "temperature": 1.0, "top_p": 0.95, "top_k": 0, "min_p": 0,
}))')"

    RAW="$(curl -s -m 180 "http://127.0.0.1:$FAST_PORT/v1/chat/completions" \
        -H 'Content-Type: application/json' -d "$BODY" 2>/dev/null)" || RAW=""
    ANSWER="$(printf '%s' "$RAW" | python3 -c '
import json, sys
try:
    print(json.load(sys.stdin)["choices"][0]["message"]["content"].strip())
except Exception:
    pass' 2>/dev/null)"
    if [ -z "$ANSWER" ]; then
        err "воркер не ответил — сервер на :$FAST_PORT запущен? (lm start fast)"
        return 1
    fi

    printf '%s\n' "$ANSWER"
    if [ "${1:-}" = "--clip" ]; then
        printf '%s' "$ANSWER" | wl-copy 2>/dev/null && notify-send -i edit-copy "Ответ воркера — в буфере" "$(printf '%s' "$ANSWER" | cut -c1-200)"
    fi
}

cmd_think() {
    if [ "${1:-}" = "--clip" ]; then
        PROMPT="$(wl-paste --no-newline 2>/dev/null || true)"
        [ -n "$PROMPT" ] || { err "буфер обмена пуст"; return 1; }
        OUT="$(printf '%s' "$PROMPT" | "$DIR/think.sh")" || return 1
    elif [ -n "${1:-}" ]; then
        OUT="$("$DIR/think.sh" "$1")" || return 1
    else
        OUT="$(cat | "$DIR/think.sh")" || return 1
    fi
    printf '%s\n' "$OUT"
    if [ "${1:-}" = "--clip" ]; then
        printf '%s' "$OUT" | wl-copy 2>/dev/null && notify-send -i edit-copy "Ответ ризонера — в буфере" "$(printf '%s' "$OUT" | tail -1 | cut -c1-200)"
    fi
}

cmd_tabs() {
    [ -d "$ZT" ] || { err "нет $ZT"; return 1; }
    (cd "$ZT" && "$BUN" bin/plan.mjs "$@")
}

cmd_logs() {
    case "${1:-fast}" in
        fast) tail -n "${2:-25}" "$DIR/logs/fast.log" ;;
        think) tail -n "${2:-25}" "$DIR/logs/think.log" ;;
        *) err "lm logs [fast|think]"; return 2 ;;
    esac
}

# Показать результат в плавающем терминале Omarchy и не закрыть окно сразу.
# Нужен для кнопок меню, где вывод длиннее строки: план разбора вкладок, логи, замер.
# Именно foot с app-id org.omarchy.terminal: правило Omarchy делает такие окна
# плавающими (875x600, по центру). Терминал по умолчанию (WezTerm) под это правило
# не подпадает и открыл бы обычный тайл в уже запущенном окне.
cmd_panel() {
    inner="lm $*; printf '\n\nEnter — закрыть'; read -r _"
    if command -v foot >/dev/null 2>&1; then
        exec foot --app-id=org.omarchy.terminal --title="Локальные модели" -e bash -c "$inner"
    elif command -v xdg-terminal-exec >/dev/null 2>&1; then
        exec xdg-terminal-exec --app-id=org.omarchy.terminal --title="Локальные модели" -e bash -c "$inner"
    else
        exec bash -c "$inner"
    fi
}

# Открыть попап расширения в Zen: браузерные сочетания работают только у
# сфокусированного окна, поэтому сначала фокусируем Zen, потом посылаем клавиши.
ext_in_db() { # 0, если расширение установлено в профиль постоянно
    profile="$(zen_profile)"
    [ -n "$profile" ] || return 1
    LC_ALL=C grep -q "zen-tabs@local" "$profile/extensions.json" 2>/dev/null
}

cmd_popup() {
    # В этой версии Hyprland диспетчеры — Lua-функции: старый «focuswindow class:…»
    # не работает, нужен hl.dsp.focus({window = …}).
    if ! hyprctl dispatch 'hl.dsp.focus({window = "class:^zen$"})' >/dev/null 2>&1; then
        err "не удалось сфокусировать окно Zen"
        return 1
    fi
    sleep 0.5
    active="$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""' 2>/dev/null)"
    if [ "$active" != "zen" ]; then
        err "фокус не на Zen (сейчас: ${active:-неизвестно}) — нажми Ctrl+Shift+U в браузере сам"
        return 1
    fi
    if ! command -v wtype >/dev/null 2>&1; then
        err "нет wtype — нажми Ctrl+Shift+U в Zen сам"
        return 1
    fi
    # Alt+Shift+U, а не Ctrl+Shift+U: второе перехватывает GTK как ввод символа
    # по коду (появляется подсказка «U+») и до расширения не доходит.
    wtype -M alt -M shift -k u -m shift -m alt
    # Если аддона нет в базе профиля, клавиша, скорее всего, ничего не сделает:
    # временные аддоны исчезают при перезапуске Zen. Предупреждаем, а не молчим.
    if ! ext_in_db; then
        notify-send -i dialog-warning "Попап не откроется?" "Расширения нет в профиле Zen — загрузи его (lm ext). Временные аддоны умирают при перезапуске браузера."
    fi
}

# Состояние расширения «Разбор вкладок» в профиле Zen: загружено ли, какой uuid,
# где собранный .xpi. Проверка по базе аддонов: временные аддоны живут до перезапуска
# браузера, поэтому «не загружено» — самая частая причина «попап не появляется».
zen_profile() {
    for d in "$HOME"/.zen/*/; do
        [ -f "$d/extensions.json" ] || continue
        printf '%s\n' "$d"
    done | while read -r d; do
        printf '%s %s\n' "$(stat -c %Y "$d/extensions.json" 2>/dev/null)" "$d"
    done | sort -rn | head -1 | cut -d' ' -f2-
}

cmd_ext() {
    profile="$(zen_profile)"
    [ -n "$profile" ] || { err "не нашёл профиль Zen"; return 1; }
    xpi="$ZT/zen-tabs@local.xpi"
    printf 'профиль: %s\n' "$profile"
    uuid="$(grep -o "zen-tabs@local[^,}]*" "$profile/prefs.js" 2>/dev/null | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | head -1)"
    [ -n "$uuid" ] && printf 'uuid расширения: %s\n' "$uuid"
    if ext_in_db; then
        printf 'постоянно установлено: ДА — попап открывается по Ctrl+Shift+U, переживает перезапуск\n'
    else
        printf 'постоянно установлено: НЕТ (в базе аддонов профиля его нет)\n'
        printf 'поставить постоянно: about:addons → шестерёнка → Install Add-on From File… → %s\n' "$xpi"
        printf 'или загрузить временно: about:debugging → Load Temporary Add-on → %s/extension/manifest.json\n' "$ZT"
    fi
    [ -f "$xpi" ] && printf 'собранный .xpi: %s\n' "$xpi" || printf 'собранный .xpi: нет — собери ./bin/make-xpi.sh в %s\n' "$ZT"
}

# --- план пространств Zen (проект zen-tabs) ---------------------------------

PLAN_DIR="$HOME/.cache/zen-tabs"
PLAN_PORT="${PLAN_PORT:-8093}"
PLAN_MODEL="${PLAN_MODEL:-8094}"   # 4B на 8094: на 40 вкладках 68 % согласия против 44 % у 2B

port_alive() {
    curl -sf -m 2 -o /dev/null "http://127.0.0.1:$1/" 2>/dev/null
}

cmd_plan() { # посчитать план и поднять локальную раздачу для расширения
    [ -d "$ZT" ] || { err "нет $ZT"; return 1; }
    mkdir -p "$PLAN_DIR"
    printf 'считаю план моделью на :%s (это батч, минуты)…\n' "$PLAN_MODEL"
    # Пишем во временный файл и подменяем в конце: иначе расширение на минуты
    # увидит пустой plan.json и решит, что плана нет.
    (cd "$ZT" && "$BUN" bin/assign.mjs --model "$PLAN_MODEL" --json >"$PLAN_DIR/plan.json.tmp") || {
        err "не удалось посчитать план — поднят ли сервер на :$PLAN_MODEL? (lm plan-model)"
        rm -f "$PLAN_DIR/plan.json.tmp"
        return 1
    }
    mv "$PLAN_DIR/plan.json.tmp" "$PLAN_DIR/plan.json"
    cmd_plan_serve
}

cmd_plan_show() { # короткая сводка готового плана
    [ -f "$PLAN_DIR/plan.json" ] || { err "плана нет — сначала: lm plan-model && lm plan"; return 1; }
    PLAN_FILE="$PLAN_DIR/plan.json" "$BUN" -e '
const plan = require(process.env.PLAN_FILE);
const by = new Map();
for (const a of plan.assignments) {
  if (!a.toName) continue;
  const rec = by.get(a.toName) || { total: 0, moved: 0, groups: new Map() };
  rec.total++;
  if (a.from !== a.toName) rec.moved++;
  rec.groups.set(a.group, (rec.groups.get(a.group) || 0) + 1);
  by.set(a.toName, rec);
}
const rows = [...by.entries()].sort((a, b) => b[1].total - a[1].total);
console.log(`план от ${String(plan.generatedAt).slice(0, 16).replace("T", " ")}: вкладок ${plan.totalTabs}, переносов ${plan.moves}`);
console.log("");
for (const [name, rec] of rows) {
  const groups = [...rec.groups.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5).map(([g, n]) => `${g} ${n}`).join(", ");
  console.log(`${name.padEnd(26)} ${String(rec.total).padStart(4)}  переносов ${String(rec.moved).padStart(4)}   ${groups}`);
}
const sizes = rows.map(([, r]) => r.total);
console.log("");
console.log(`ровно было бы ${Math.round(plan.totalTabs / rows.length)} на пространство; разброс ${Math.min(...sizes)}–${Math.max(...sizes)}`);
' PLAN_FILE="$PLAN_DIR/plan.json"
}

cmd_plan_serve() {
    mkdir -p "$PLAN_DIR"
    # Основной путь — пользовательская служба systemd: она переживает и перезапуск
    # браузера, и выход из этой сессии (разовый nohup умирал вместе с родителем).
    if systemctl --user list-unit-files zen-tabs-plan.service >/dev/null 2>&1 &&
        systemctl --user cat zen-tabs-plan.service >/dev/null 2>&1; then
        systemctl --user start zen-tabs-plan.service 2>/dev/null
        sleep 1
        if port_alive "$PLAN_PORT"; then
            echo "план раздаётся службой zen-tabs-plan: http://127.0.0.1:$PLAN_PORT/plan.json"
            return 0
        fi
    fi
    if port_alive "$PLAN_PORT"; then
        echo "раздача уже идёт: http://127.0.0.1:$PLAN_PORT/plan.json"
        return 0
    fi
    # Запасной путь, если службы нет: отсоединённый процесс (setsid — своя сессия).
    (cd "$PLAN_DIR" && setsid nohup python3 -m http.server "$PLAN_PORT" --bind 127.0.0.1 >/dev/null 2>&1 &
     echo $! >"$PLAN_DIR/serve.pid")
    sleep 1
    if port_alive "$PLAN_PORT"; then
        echo "план раздаётся: http://127.0.0.1:$PLAN_PORT/plan.json — расширение его подхватит"
    else
        err "раздача не поднялась"; return 1
    fi
}

cmd_plan_stop() {
    if systemctl --user is-active zen-tabs-plan.service >/dev/null 2>&1; then
        systemctl --user stop zen-tabs-plan.service && echo "раздача плана остановлена (служба zen-tabs-plan)"
        return 0
    fi
    [ -f "$PLAN_DIR/serve.pid" ] || { echo "раздача не запущена"; return 0; }
    pid="$(cat "$PLAN_DIR/serve.pid")"
    kill "$pid" 2>/dev/null && echo "раздача плана остановлена (pid $pid)"
    rm -f "$PLAN_DIR/serve.pid"
}

# Модель для планирования: 4B поднимается на CPU, чтобы не вытеснять серверы.
cmd_plan_model() {
    if port_alive "$PLAN_MODEL"; then
        echo "модель планирования уже поднята на :$PLAN_MODEL"; return 0
    fi
    BIN="${LLAMA_SERVER:-$HOME/Bonsai-demo/bin/cuda/llama-server}"
    GGUF="${PLAN_GGUF:-$HOME/Projects/semif/models/Qwen_Qwen3.5-4B-Q4_K_M.gguf}"
    [ -f "$GGUF" ] || { err "нет модели: $GGUF"; return 1; }
    echo "поднимаю 4B на CPU (порт $PLAN_MODEL, VRAM не трогаю)…"
    LD_LIBRARY_PATH="$(dirname "$BIN")" nohup "$BIN" -m "$GGUF" --host 127.0.0.1 --port "$PLAN_MODEL" \
        -ngl 0 -t 16 -c 8192 -np 1 --jinja \
        --chat-template-kwargs '{"enable_thinking": false}' >"$DIR/logs/plan-model.log" 2>&1 &
    echo $! >"$RUN_DIR/plan-model.pid"
    i=0
    while [ "$i" -lt 180 ]; do
        if curl -sf -m 2 -o /dev/null "http://127.0.0.1:$PLAN_MODEL/health" 2>/dev/null; then
            echo "  ✓ http://127.0.0.1:$PLAN_MODEL готов"
            return 0
        fi
        i=$((i + 1)); sleep 1
    done
    err "модель не поднялась за 180 с — смотри logs/plan-model.log"
    return 1
}

cmd_plan_model_stop() {
    pid=""
    [ -f "$RUN_DIR/plan-model.pid" ] && pid="$(cat "$RUN_DIR/plan-model.pid")"
    if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
        # pid-файл мог потеряться (например, при неудачной остановке) — ищем по порту.
        pid="$(pgrep -f "llama-server.*--port $PLAN_MODEL" | head -1)"
    fi
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null && echo "модель планирования остановлена (pid $pid)"
    else
        echo "модель планирования не запущена"
    fi
    rm -f "$RUN_DIR/plan-model.pid"
}

# --- меню -------------------------------------------------------------------

menu_items() {
    cat <<'EOF'
status|Состояние серверов
start|Запустить оба сервера
start-fast|Запустить воркера (MiniCPM 2B, :8091)
start-think|Запустить ризонера (VibeThinker 3B, :8092)
stop|Остановить всё
restart|Перезапустить оба
ask|Спросить воркера — текст из буфера обмена
think|Решить ризонером — текст из буфера обмена
tabs|Разобрать вкладки Zen по смыслу
tabs-domain|Разобрать вкладки Zen по доменам
popup|Открыть попап расширения в Zen (Ctrl+Shift+U)
plan-show|План пространств Zen: показать текущий
plan|План пространств Zen: пересчитать (4B на CPU, минуты) и раздать
eval|Замер SemIf (144 авторских пункта)
logs-fast|Логи воркера
logs-think|Логи ризонера
EOF
}

run_action() {
    case "$1" in
        status) cmd_status ;;
        start) cmd_start all ;;
        start-fast) cmd_start fast ;;
        start-think) cmd_start think ;;
        stop) cmd_stop ;;
        restart) cmd_stop; sleep 1; cmd_start all ;;
        ask) cmd_ask --clip ;;
        think) cmd_think --clip ;;
        tabs) cmd_tabs ;;
        tabs-domain) cmd_tabs --domain ;;
        popup) cmd_popup ;;
        plan) cmd_plan_model && cmd_plan ;;
        plan-show) shift; cmd_plan_show ;;
        eval) (cd "$DIR" && ./semif-eval.sh) ;;
        logs-fast) cmd_logs fast 40 ;;
        logs-think) cmd_logs think 40 ;;
        *) err "неизвестное действие: $1"; return 2 ;;
    esac
}

cmd_menu() {
    header="$(cmd_status 2>&1)"
    choice="$(menu_items | fzf --height=100% --reverse --delimiter='\|' --with-nth=2 \
        --prompt='локальные модели> ' --header="$header" --header-first --no-info)" || return 0
    [ -n "$choice" ] || return 0
    key="${choice%%|*}"
    printf '\n→ %s\n\n' "${choice#*|}"
    run_action "$key"
    printf '\n(Enter — закрыть)'
    read -r _ 2>/dev/null || true
}

# --- разбор аргументов ------------------------------------------------------

case "${1:-menu}" in
    menu | --list)
        if [ "${1:-}" = "--list" ]; then menu_items; else cmd_menu; fi
        ;;
    status) cmd_status ;;
    notify-status) cmd_notify_status ;;
    up) cmd_status >/dev/null 2>&1 ;;
    alive)
        case "${2:-}" in
            fast) alive "$FAST_PORT" ;;
            think) alive "$THINK_PORT" ;;
            *) err "lm alive [fast|think]"; exit 2 ;;
        esac
        ;;
    start) shift; cmd_start "${1:-all}" ;;
    stop) cmd_stop ;;
    restart) run_action restart ;;
    ask) shift; cmd_ask "${1:-}" ;;
    think) shift; cmd_think "${1:-}" ;;
    tabs) shift; cmd_tabs "$@" ;;
    eval) shift; (cd "$DIR" && ./semif-eval.sh) ;;
    logs) shift; cmd_logs "${1:-fast}" "${2:-25}" ;;
    panel) shift; cmd_panel "$@" ;;
    popup) shift; cmd_popup "$@" ;;
    ext) shift; cmd_ext ;;
    plan) shift; cmd_plan "$@" ;;
    plan-show) shift; cmd_plan_show ;;
    plan-serve) shift; cmd_plan_serve ;;
    plan-stop) shift; cmd_plan_stop ;;
    plan-model) shift; cmd_plan_model ;;
    plan-model-stop) shift; cmd_plan_model_stop ;;
    -h | --help | help)
        sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        err "неизвестная команда: $1 (lm --help)"
        exit 2
        ;;
esac
